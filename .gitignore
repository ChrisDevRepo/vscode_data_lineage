# Dependencies
node_modules/

# Build outputs
dist/
out/
*.vsix

# Testing
test-results/
**/test-results/**
.vscode-test/

# IDE / local
# Keep the repository workspace settings tracked: they deliberately disable unrelated
# MCP servers so @lineage remains the only AI tool surface while developing this solution.
tmp/
PLAN*.md

# Environment
.env
.env.example
*.log

# Ad-hoc debug dumps written by tests/tools — never tracked, never packaged
debug*.txt

# OS
.DS_Store
Thumbs.db

# AI assistant config — NEVER commit to public repo
# These folders contain local context, prompts, credentials, and internal instructions.
AGENTS.md
.AGENTS.md
CLAUDE.md
.CLAUDE.md
.claude/
**/.claude/**
GEMINI.md
.GEMINI.md
.gemini/
**/.gemini/**
.cursor/
**/.cursor/**
.aider*
.continue/
**/.continue/**
.agents/
**/.agents/**

# Internal Developer Docs
*internal*/
**/*internal*/**

# Verification scripts and artifacts (contents-pattern so tracked build tooling can be re-included:
# git cannot negate below an excluded directory)
scripts/*
# The gate's manifest step runs this — it must be committable.
!scripts/generate-tool-manifest.mjs

# Code-audit workspace (tool output, inventories, classification artifacts)
.audit/

# Package-verification scratch trees (.verify-tmp, .verify2, …). Each holds a full copy of the
# repository, so an unignored one is picked up by `vsce ls` and would ship source in the VSIX.
.verify*/

# Python venv for the analysis scripts (stdlib-only; never bundled).
.venv/

# The ai-disabled EDH lane's seeded user-data-dir: only the settings seed is tracked; everything
# else is runtime state the Electron host writes on every run.
tests/fixtures/kill-switch-user-data/*
!tests/fixtures/kill-switch-user-data/User/
tests/fixtures/kill-switch-user-data/User/*
!tests/fixtures/kill-switch-user-data/User/settings.json
