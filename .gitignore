# Public vendor-neutral agent entry point.
!/AGENTS.md

# Internal Developer Docs
*internal*/
**/*internal*/**
internal-tests/**

# Verification scripts and artifacts (contents-pattern so tracked build tooling can be re-included:
# git cannot negate below an excluded directory)
scripts/*
# The gate's manifest step runs this — it must be committable.
!scripts/generate-tool-manifest.mjs
# The postinstall hook runs this — it must be committable or fresh clones break.
!scripts/repair-langsmith-stub.mjs
# Regenerates THIRD_PARTY_NOTICES.md from the bundled package set.
!scripts/generate-third-party-notices.mjs
# Verifies state-of-the-art TSDoc and non-chatty code comments across src/.
!scripts/verify-code-comments.mjs
# Fails the gate when a tracked Markdown file names a link, path, script or setting that does not exist.
!scripts/verify-docs.mjs

# Code-audit workspace (tool output, inventories, classification artifacts)
.audit/

# Generated reviews and audit reports stay local.
.reviews/
review/
reviews/
audit/
audits/
[Rr][Ee][Vv][Ii][Ee][Ww]*.[Mm][Dd]
*[-_.][Rr][Ee][Vv][Ii][Ee][Ww]*.[Mm][Dd]
[Aa][Uu][Dd][Ii][Tt]*.[Mm][Dd]
*[-_.][Aa][Uu][Dd][Ii][Tt]*.[Mm][Dd]

# Package-verification scratch trees (.verify-tmp, .verify2, …). Each holds a full copy of the
# repository, so an unignored one is picked up by `vsce ls` and would ship source in the VSIX.
.verify*/

# Local Python virtual environments (never bundled).
.venv/

# The ai-disabled EDH lane's seeded user-data-dir: only the settings seed is tracked; everything
# else is runtime state the Electron host writes on every run.
tests/fixtures/kill-switch-user-data/*
!tests/fixtures/kill-switch-user-data/User/
tests/fixtures/kill-switch-user-data/User/*
!tests/fixtures/kill-switch-user-data/User/settings.json

# A dacpac at the repo root is an internal model staged for a lane run, never product
# content; the tracked fixtures live under tests/fixtures/ and assets/ and are unaffected.
/*.dacpac
