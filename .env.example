# Optional provider runners: npm run test:ai:smoke / npm run test:ai:headless
# Pick one profile per run: azure, fireworks, openrouter, or openai-compatible.
AI_TEST_PROVIDER=
AI_TEST_ENDPOINT=
AI_TEST_API_KEY=
AI_TEST_MODEL=
AI_TEST_REASONING_EFFORT=

# Optional database smoke: configure only a disposable/demo database.
DB_TEST_SERVER=
DB_TEST_DATABASE=
# Optional read-only SQL-login runner: npm run test:db:smoke
# Use a disposable/demo database with metadata permissions. No provisioning is performed.
DB_TEST_USER=
DB_TEST_PASSWORD=
DB_TEST_PORT=
DB_TEST_ENCRYPT=true
DB_TEST_TRUST_SERVER_CERTIFICATE=false

# Optional headless trace export: npm run test:ai:headless -- --langfuse
# Export is disabled unless requested. Verbose prompt/body export also needs --trace-verbose.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
