# Optional provider runners: npm run test:ai:smoke / npm run test:ai:headless
# Cloud provider: azure, fireworks, openrouter, openai-compatible
# There is no default provider; a missing one stops the run with a configuration error.
AI_TEST_PROVIDER=
AI_TEST_ENDPOINT=
AI_TEST_API_KEY=
AI_TEST_MODEL=
AI_TEST_REASONING_EFFORT=low
# AI run/native test budget (default 2 hours); increase for slower local models.
AI_TEST_TIMEOUT_MS=7200000
# Per-request budget; empty uses the AI test budget.
AI_TEST_REQUEST_TIMEOUT_MS=

# Optional native badge setup: 1 runs fresh real-model analysis instead of requiring a recorded trace.
DLV_CHAT_UI_BADGE_LIVE=

# Optional database smoke: configure only a disposable/demo database.
DB_TEST_SERVER=
DB_TEST_DATABASE=
# Optional database smoke runner: npm run test:db:smoke
# Supports SQL login (sqlLogin) and Microsoft Entra ID (entraId with a token or explicit noninteractive test login).
# DB_TEST_AUTH_TYPE defaults to sqlLogin; set entraId for Microsoft Entra ID.
DB_TEST_AUTH_TYPE=
DB_TEST_USER=
DB_TEST_PASSWORD=
DB_TEST_TENANT_ID=
DB_TEST_TOKEN=
# Optional noninteractive Entra test login instead of an existing token; requires tenant, user and password.
DB_TEST_CLIENT_ID=
DB_TEST_PORT=
DB_TEST_ENCRYPT=true
DB_TEST_TRUST_SERVER_CERTIFICATE=false

# Local NDJSON under ignored test-results/headless is the production quick-analysis log.
# Debug tracing is opt-in: npm run test:ai:headless -- --langfuse
# Verbose prompt and body capture also needs --trace-verbose.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
