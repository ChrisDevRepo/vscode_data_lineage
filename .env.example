# Optional live smoke: npm run test:ai:smoke registers this endpoint as a VS Code custom-endpoint model (BYOK).
# Provider (names the variable aliases only): azure, fireworks, openai-compatible
# Without these names the smoke skips and says which are missing.
AI_TEST_PROVIDER=
AI_TEST_ENDPOINT=
AI_TEST_API_KEY=
AI_TEST_MODEL=
AI_TEST_REASONING_EFFORT=low
# The model's real context and output window (vendor documentation); VS Code advertises them to the product. Required for a live run, no default.
AI_TEST_MAX_INPUT_TOKENS=
AI_TEST_MAX_OUTPUT_TOKENS=
# AI run/native test budget (default 2 hours); increase for slower local models.
AI_TEST_TIMEOUT_MS=7200000
