# Key Vault
KV_NAME=

# Optional provider runner: npm run test:ai:headless
# One model entry on the product provider port (the fields of an ai.models entry).
AI_TEST_ENDPOINT=
AI_TEST_API_KEY=
AI_TEST_MODEL=
# chat-completions or responses
AI_TEST_API_TYPE=chat-completions
AI_TEST_MAX_INPUT_TOKENS=
AI_TEST_MAX_OUTPUT_TOKENS=
# Optional: reasoning effort, false sends tool_choice auto, extra request body as JSON.
AI_TEST_REASONING_EFFORT=
AI_TEST_FORCED_TOOL_CHOICE=
AI_TEST_REQUEST_BODY=

# Optional database smoke: configure only a disposable/demo database.
DB_TEST_SERVER=
DB_TEST_DATABASE=
# Optional read-only SQL-login runner: npm run test:db:smoke
# Use a disposable/demo database with metadata permissions. No provisioning is performed.
DB_TEST_USER=
DB_TEST_PASSWORD=
DB_TEST_PORT=
DB_TEST_ENCRYPT=true
DB_TEST_TRUST_SERVER_CERTIFICATE=false
