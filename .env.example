# Optional provider runners: npm run test:ai:smoke
# Cloud provider: azure, fireworks, openrouter, openai-compatible, qwen
# There is no default provider; a missing one stops the run with a configuration error.
AI_TEST_PROVIDER=
AI_TEST_ENDPOINT=
AI_TEST_API_KEY=
AI_TEST_MODEL=
AI_TEST_REASONING_EFFORT=low
# The model's real context and output window (vendor documentation); the fixture advertises them to the product. Required for a live run, no default.
AI_TEST_MAX_INPUT_TOKENS=
AI_TEST_MAX_OUTPUT_TOKENS=
# AI run/native test budget (default 2 hours); increase for slower local models.
AI_TEST_TIMEOUT_MS=7200000
# Per-request budget; empty uses the AI test budget.
AI_TEST_REQUEST_TIMEOUT_MS=
