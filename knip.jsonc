{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/utils/layout.worker.ts",
    ".vscode-test*.mjs",
    "tests/integration/**/*.test.ts",
    "tests/scale/layout.test.ts",
    "tests/scale/vitest.config.ts",
    "scripts/generate-third-party-notices.mjs",
    // Run by npm scripts and the gate, or loaded by run-headless from the compiled harness.
    "tests/tools/*.mjs",
    "tests/harness/{cli,vscodeHostShim}.ts",
    "src/index.css",
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "tests/**/*.{ts,tsx,mjs,js}",
    "scripts/*.mjs",
    "*.{ts,mjs}",
  ],
  // Exports tagged @internal are test seams, not product API.
  "tags": ["-internal"],
  // VS Code supplies this module; @types/vscode provides the build-time API.
  "ignoreDependencies": ["@types/vscode"],
}
